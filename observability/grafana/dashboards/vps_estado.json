{
  "uid": "vps-estado",
  "title": "Estado del VPS",
  "tags": ["vps"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "gauge", "title": "CPU del servidor", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 60}, {"color": "red", "value": 85}]}}, "overrides": []}
    },
    {
      "type": "gauge", "title": "RAM del servidor", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 85}]}}, "overrides": []}
    },
    {
      "type": "gauge", "title": "Disco del servidor", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\", fstype!~\"tmpfs|overlay\"})", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 70}, {"color": "red", "value": 85}]}}, "overrides": []}
    },
    {
      "type": "stat", "title": "Contenedores corriendo", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "expr": "count(docker_container_mem_usage)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []}
    },
    {
      "type": "stat", "title": "Saturaciones activas", "gridPos": {"x": 16, "y": 0, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []}
    },
    {
      "type": "stat", "title": "Load (5m)", "gridPos": {"x": 20, "y": 0, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "expr": "node_load5", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 8}, {"color": "red", "value": 14}]}}, "overrides": []}
    },
    {
      "type": "piechart", "title": "RAM por aplicación (y libre)", "gridPos": {"x": 0, "y": 6, "w": 8, "h": 10},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {"pieType": "donut", "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}, "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {"refId": "A", "expr": "sum by (com_docker_compose_project) (docker_container_mem_usage)", "legendFormat": "{{com_docker_compose_project}}", "instant": true},
        {"refId": "B", "expr": "node_memory_MemAvailable_bytes", "legendFormat": "LIBRE", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": [{"matcher": {"id": "byName", "options": "LIBRE"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "semi-dark-green"}}]}]}
    },
    {
      "type": "piechart", "title": "CPU por aplicación (ahora)", "gridPos": {"x": 8, "y": 6, "w": 8, "h": 10},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {"pieType": "donut", "legend": {"displayMode": "table", "placement": "right", "values": ["value"]}, "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"refId": "A", "expr": "sum by (com_docker_compose_project) (docker_container_cpu_usage_percent)", "legendFormat": "{{com_docker_compose_project}}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}, "overrides": []}
    },
    {
      "type": "bargauge", "title": "Ranking: quién ocupa más RAM (por contenedor)", "gridPos": {"x": 16, "y": 6, "w": 8, "h": 10},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"refId": "A", "expr": "topk(12, docker_container_mem_usage)", "legendFormat": "{{container_name}}", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0}, "overrides": []}
    },
    {
      "type": "timeseries", "title": "Saturaciones (historial de alertas)", "gridPos": {"x": 0, "y": 16, "w": 24, "h": 6},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "expr": "max by (alertname, container_name) (ALERTS{alertstate=\"firing\"})", "legendFormat": "{{alertname}} · {{container_name}}"}],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "bars", "fillOpacity": 80}}, "overrides": []}
    }
  ]
}
